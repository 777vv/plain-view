{
  "manifest_version": 3,
  "name": "Plain View",
  "version": "0.1.0",
  "description": "Plain View — friendly in-browser viewer for JSON, Markdown, SQL, YAML, CSV and LOG files.",

  "permissions": ["storage", "downloads", "contextMenus"],

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Plain View",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/index.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "dist/renderers/*.js",
        "dist/ui/*.js",
        "dist/decoders/*.js",
        "dist/playground/*.js",
        "styles/*.css",
        "playground.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
